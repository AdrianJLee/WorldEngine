# 行尾与二进制处理(2026-09-23,R3:修"逐字节门禁被 CRLF 误伤"的陷阱)
#
# 背景:本机 core.autocrlf 生效时,签出写 CRLF、提交转回 LF;而
# tests/ScriptWorkflowTests.cpp 的"存根漂移门禁"对
# projects/default/assets/scripts/intermediate/WorldEngineAPI.luau 做逐字节比较,
# 工作树是 CRLF 时会误报失败(内容逐行相同)。
#
# 策略:只对"逐字节门禁涉及的文本"强制 LF,避免全仓 renormalize 造成无关 diff。

*.luau text eol=lf
*.lua  text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf

# 生成物:漂移门禁(schema-compiler --check)逐字节比较 → 必须固定 LF,
# 否则分支切换/签出把工作树写回 CRLF 就会误报 drift。
Engine/src/World/Schema/Generated/** text eol=lf
Game/src/Generated/**               text eol=lf
tests/**/Generated/**               text eol=lf

# 二进制:永远不做文本转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.exe   binary
*.dll   binary
*.lib   binary
*.pdb   binary
*.spv   binary
*.zip   binary
*.gz    binary
*.wav   binary
*.mp3   binary
