FormatVersion: 2
Scene: ExamplePixelCamera
Entities:
  - World::UUIDComponent:
      ID:
        m_UUID: 910000000000000201
    World::TagComponent:
      Tag: Pixel Perfect Camera
    World::TransformComponent:
      Location: [0, 0, 10]
      Rotation: [0, 0, 0, 1]
      Scale: [1, 1, 1]
    World::CameraComponent:
      Camera:
        m_ProjectionType: 1
        m_OrthographicZoom: 5.625
        m_OrthographicNearClip: -100
        m_OrthographicFarClip: 100
        m_PerspectiveFOV: 45
        m_PerspectiveNearClip: 0.1
        m_PerspectiveFarClip: 100
      Primary: true
      FixedAspectRatio: false
    World::PixelPerfectCameraComponent:
      ReferenceResolution: [320, 180]
      PixelsPerUnit: 16
      CurrentScale: 1
      SnapToPixelGrid: true
      UpscaleRT: false
