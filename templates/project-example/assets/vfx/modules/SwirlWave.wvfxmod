Id: mod.custom.swirl_wave
Name: 旋涡波动力学 (Swirl Wave)
Description: 基于正交分量与正弦波的高阶旋转动力学
Stage: Update
Enabled: true
IsCustom: true
SlangSource: |-
  // [Project Custom Slang Module: Swirl Wave]
  float dist = length(p.Position.xz);
  float angle = p.Life * u_WaveFrequency;
  float3 swirlForce = float3(-sin(angle), cos(angle) * 0.5f, cos(angle)) * (u_SwirlGain * dt);
  p.Velocity += swirlForce;
  p.Position.y += sin(p.Life * u_WaveFrequency * 2.0f) * (0.2f * dt);
Parameters:
  - Name: SwirlGain
    Type: 0
    FloatVal: 3.0
    VecVal: [0, 0, 0, 0]
    IntVal: 0
    BoolVal: false
    Min: 0.0
    Max: 20.0
    Step: 0.1
    Tooltip: 旋涡切向力增益
    IsExposed: true
    ExposedName: SwirlGain
  - Name: WaveFrequency
    Type: 0
    FloatVal: 2.0
    VecVal: [0, 0, 0, 0]
    IntVal: 0
    BoolVal: false
    Min: 0.1
    Max: 10.0
    Step: 0.1
    Tooltip: 波动角频率
    IsExposed: true
    ExposedName: WaveFrequency
