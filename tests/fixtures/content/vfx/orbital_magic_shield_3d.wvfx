            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: -30
            Max: 30
            Step: 0.200000003
            Tooltip: 轨道公转切向角速率
            IsExposed: false
            ExposedName: ""
          - Name: OrbitAxis
            Type: 2
            Mode: 0
            RandomMin: 0
            RandomMax: 1
