            IsExposed: false
            ExposedName: ""
      - Id: mod.update.solve_velocity
        Name: "物理积分与生命周期 (Solve Velocity & Life)"
        Description: 欧拉物理速度积分更新位置，递减生命周期并计算归一化时间
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: SolveVelocity] 物理欧拉积分与消亡\n    p.Position += p.Velocity * dt;\n    p.Life -= dt;\n    if (u_SpeedDamping > 0.001f)\n        p.Velocity *= max(0.0f, 1.0f - u_SpeedDamping * dt);\n"
        Parameters:
          - Name: SpeedDamping
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            RandomMinVec: [0, 0, 0, 0]
            RandomMaxVec: [1, 1, 1, 1]
            SplitAxes: false
            SplitColor: false
            ActiveAxisCurveChannel: 0
            ActiveColorCurveChannel: 0
            CurveExpanded: true
            AlphaCurveExpanded: false
            AxisMode: [0, 0, 0]
            AxisRandomMin: [-10, -10, -10]
            AxisRandomMax: [10, 10, 10]
            AxisCurveExpanded: [false, false, false]
            ColorMode: [0, 0, 0, 0]
            ColorRandomMin: [0, 0, 0, 0]
            ColorRandomMax: [1, 1, 1, 1]
            ColorCurveExpanded: [false, false, false, false]
            FloatVal: 0
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 5
            Step: 0.0500000007
            Tooltip: 物理速度阻尼
            IsExposed: false
            ExposedName: ""
