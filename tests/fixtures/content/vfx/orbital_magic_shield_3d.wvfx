      MaterialPath: materials/particles/particle_additive.wmat
      BlendMode: Additive
      FacingMode: HorizontalQuad
      EmissiveBoost: 6
      SoftParticle: false
      FadeDistance: 0.5
      SubUV:
        TilesX: 1
        TilesY: 1
        FPS: 0
