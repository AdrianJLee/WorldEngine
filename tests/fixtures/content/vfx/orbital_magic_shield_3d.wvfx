      - Id: mod.update.color_over_life
        Name: 色彩淡入淡出 (Color Over Life)
        Description: 基于粒子存活进度进行色彩与透明度渐变过渡
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: Color Over Life]\n    float normLife = clamp(1.0f - (p.Life / max(0.001f, p.MaxLife)), 0.0f, 1.0f);\n    p.Color = lerp(u_ColorStart, u_ColorEnd, normLife);\n"
        Parameters:
          - Name: ColorStart
            Type: 3
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            RandomMinVec: [0, 0, 0, 0]
            RandomMaxVec: [1, 1, 1, 1]
            SplitAxes: false
            SplitColor: false
            ActiveAxisCurveChannel: 0
            ActiveColorCurveChannel: 0
            CurveExpanded: true
            AlphaCurveExpanded: false
            AxisMode: [0, 0, 0]
            AxisRandomMin: [-10, -10, -10]
            AxisRandomMax: [10, 10, 10]
            AxisCurveExpanded: [false, false, false]
            ColorMode: [0, 0, 0, 0]
            ColorRandomMin: [0, 0, 0, 0]
            ColorRandomMax: [1, 1, 1, 1]
            ColorCurveExpanded: [false, false, false, false]
            FloatVal: 1
            VecVal: [0.349999994, 0.879999995, 1, 0.949999988]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 0.00999999978
            Tooltip: 初始出生颜色 (RGBA)
            IsExposed: false
            ExposedName: ""
