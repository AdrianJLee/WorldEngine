FormatVersion: 1
Name: OrbitalMagicShield3D
Guid: 0
Seed: 1337
Duration: 5
Looping: true
WarmupTime: 0
LOD:
  CullDistance: 60
  PauseWhenOffscreen: true
Emitters:
  - Name: RunicGroundMatrix
    MaxParticles: 1
    Lifetime: 9999
    EmissionRate: 0
    EmitterDuration: 0
    EmitterLooping: true
    EmissionMode: 0
    SingleCount: 1
    Enabled: true
    Emitter:
      Type: Point
      LockToXY: false
