      - Id: mod.update.shockwave_expansion
        Name: 冲击波扩散衰减 (Shockwave Expansion)
        Description: 模拟地表冲击波光环从原点快速径向扩张扩散，并伴随缓出透明度衰减
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: Shockwave Expansion]\n    float normLife = clamp(1.0f - (p.Life / max(0.001f, p.MaxLife)), 0.0f, 1.0f);\n    p.Size = float2(lerp(0.5f, u_MaxRadius, sqrt(normLife)));\n    p.Color.a *= max(0.0f, 1.0f - normLife * u_DissipationRate);\n"
        Parameters:
          - Name: ExpansionSpeed
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            RandomMinVec: [0, 0, 0, 0]
            RandomMaxVec: [1, 1, 1, 1]
            SplitAxes: false
            SplitColor: false
            ActiveAxisCurveChannel: 0
            ActiveColorCurveChannel: 0
            CurveExpanded: true
            AlphaCurveExpanded: false
            AxisMode: [0, 0, 0]
            AxisRandomMin: [-10, -10, -10]
            AxisRandomMax: [10, 10, 10]
            AxisCurveExpanded: [false, false, false]
            ColorMode: [0, 0, 0, 0]
            ColorRandomMin: [0, 0, 0, 0]
            ColorRandomMax: [1, 1, 1, 1]
            ColorCurveExpanded: [false, false, false, false]
            FloatVal: 7.5
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.100000001
            Max: 30
            Step: 0.200000003
            Tooltip: 冲击波尺寸扩张速率 (m/s)
            IsExposed: false
            ExposedName: ""
          - Name: MaxRadius
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            RandomMinVec: [0, 0, 0, 0]
            RandomMaxVec: [1, 1, 1, 1]
            SplitAxes: false
            SplitColor: false
            ActiveAxisCurveChannel: 0
            ActiveColorCurveChannel: 0
            CurveExpanded: true
            AlphaCurveExpanded: false
            AxisMode: [0, 0, 0]
            AxisRandomMin: [-10, -10, -10]
            AxisRandomMax: [10, 10, 10]
            AxisCurveExpanded: [false, false, false]
            ColorMode: [0, 0, 0, 0]
            ColorRandomMin: [0, 0, 0, 0]
            ColorRandomMax: [1, 1, 1, 1]
            ColorCurveExpanded: [false, false, false, false]
            FloatVal: 8.5
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.5
            Max: 50
            Step: 0.5
            Tooltip: 最大扩散外圈尺寸
            IsExposed: false
            ExposedName: ""
          - Name: DissipationRate
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            RandomMinVec: [0, 0, 0, 0]
            RandomMaxVec: [1, 1, 1, 1]
            SplitAxes: false
