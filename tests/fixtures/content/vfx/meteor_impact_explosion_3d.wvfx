FormatVersion: 1
Name: MeteorImpactExplosion3D
Guid: 0
Seed: 1337
Duration: 2.5
Looping: false
WarmupTime: 0
LOD:
  CullDistance: 60
  PauseWhenOffscreen: true
Emitters:
  - Name: BlastShockwave
    MaxParticles: 1
    Lifetime: 1
    EmissionRate: 0
    EmitterDuration: 0
    EmitterLooping: true
    EmissionMode: 0
    SingleCount: 1
    Enabled: true
    Emitter:
