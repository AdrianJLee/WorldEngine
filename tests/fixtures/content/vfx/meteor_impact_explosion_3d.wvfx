            ColorRandomMin: [0, 0, 0, 0]
            ColorRandomMax: [1, 1, 1, 1]
            ColorCurveExpanded: [false, false, false, false]
            FloatVal: 0
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 5
            Step: 0.0500000007
            Tooltip: 物理速度阻尼
            IsExposed: false
            ExposedName: ""
