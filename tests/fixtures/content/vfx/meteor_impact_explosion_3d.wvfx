        TilesX: 1
        TilesY: 1
        FPS: 0
        RandomStart: false
    Motion:
      Speed: 5
      SpeedVariance: 1
      Gravity: [0, -9.80000019, 0]
      LinearDrag: 0
      VortexStrength: 0
      VortexAxis: [0, 1, 0]
      TurbulenceStrength: 0
      TurbulenceFrequency: 1
    Evolution:
      SizeStart: 0.5
      SizeEnd: 0.100000001
      ColorStart: [1, 1, 1, 1]
      ColorEnd: [1, 1, 1, 0]
    Collision:
      Mode: None
      Restitution: 0.5
      Friction: 0.100000001
      KillOnHit: false
      EnableEvents: false
      PlaneOrigin: [0, 0, 0]
      PlaneNormal: [0, 1, 0]
    Bursts:
      - Time: 0
        Count: 1
    UseCustomShaderOverride: false
    Modules:
      - Id: mod.emitter.spawn_burst
        Name: 瞬态爆发/单体 (Spawn Burst)
        Description: 在指定时间瞬间爆发生成固定数量图元 (Count=1 用于法阵/护盾/光环，零发射流开销)
        Stage: Emitter
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: SpawnBurst]\n    // 在指定时间瞬间生成指定数量的粒子或单体网格图元\n"
        Parameters:
          - Name: SpawnCount
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            RandomMinVec: [0, 0, 0, 0]
            RandomMaxVec: [1, 1, 1, 1]
            SplitAxes: false
            SplitColor: false
            ActiveAxisCurveChannel: 0
            ActiveColorCurveChannel: 0
            CurveExpanded: true
            AlphaCurveExpanded: false
            AxisMode: [0, 0, 0]
            AxisRandomMin: [-10, -10, -10]
            AxisRandomMax: [10, 10, 10]
            AxisCurveExpanded: [false, false, false]
            ColorMode: [0, 0, 0, 0]
            ColorRandomMin: [0, 0, 0, 0]
            ColorRandomMax: [1, 1, 1, 1]
            ColorCurveExpanded: [false, false, false, false]
            FloatVal: 1
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 1
            Max: 10000
            Step: 1
            Tooltip: 瞬时生成图元数量 (1 为单体法阵/护盾)
            IsExposed: true
            ExposedName: BurstCount
