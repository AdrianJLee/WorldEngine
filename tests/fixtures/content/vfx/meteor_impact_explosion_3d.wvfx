      - Id: mod.update.color_over_life
        Name: 色彩淡入淡出 (Color Over Life)
        Description: 基于粒子存活进度进行色彩与透明度渐变过渡
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: Color Over Life]\n    float normLife = clamp(1.0f - (p.Life / max(0.001f, p.MaxLife)), 0.0f, 1.0f);\n    p.Color = lerp(u_ColorStart, u_ColorEnd, normLife);\n"
        Parameters:
          - Name: ColorStart
            Type: 3
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            RandomMinVec: [0, 0, 0, 0]
