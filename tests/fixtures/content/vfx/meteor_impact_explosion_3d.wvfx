      - Id: mod.spawn.sphere
        Name: 球体发射 (Sphere Spawn)
        Description: 在 3D 球体表面或体积内均匀随机生成粒子并向外辐射扩散
        Stage: Spawn
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: SphereSpawn] 球面随机分布\n    float z = 1.0f - 2.0f * Hash1D(particleId * 4 + 1);\n    float r = sqrt(max(0.0f, 1.0f - z * z));\n    float phi = 6.2831853f * Hash1D(particleId * 4 + 2);\n    float3 normalDir = float3(r * cos(phi), z, r * sin(phi));\n    p.Position = normalDir * u_SphereRadius;\n    p.Velocity = normalDir * u_OutwardSpeed;\n"
        Parameters:
          - Name: SphereRadius
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            RandomMinVec: [0, 0, 0, 0]
            RandomMaxVec: [1, 1, 1, 1]
            SplitAxes: false
            SplitColor: false
            ActiveAxisCurveChannel: 0
            ActiveColorCurveChannel: 0
            CurveExpanded: true
            AlphaCurveExpanded: false
            AxisMode: [0, 0, 0]
            AxisRandomMin: [-10, -10, -10]
            AxisRandomMax: [10, 10, 10]
            AxisCurveExpanded: [false, false, false]
            ColorMode: [0, 0, 0, 0]
            ColorRandomMin: [0, 0, 0, 0]
            ColorRandomMax: [1, 1, 1, 1]
            ColorCurveExpanded: [false, false, false, false]
            FloatVal: 0.400000006
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.0500000007
            Max: 20
            Step: 0.100000001
            Tooltip: 球体生成半径
            IsExposed: false
            ExposedName: ""
          - Name: OutwardSpeed
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            RandomMinVec: [0, 0, 0, 0]
            RandomMaxVec: [1, 1, 1, 1]
            SplitAxes: false
            SplitColor: false
            ActiveAxisCurveChannel: 0
            ActiveColorCurveChannel: 0
            CurveExpanded: true
            AlphaCurveExpanded: false
            AxisMode: [0, 0, 0]
            AxisRandomMin: [-10, -10, -10]
            AxisRandomMax: [10, 10, 10]
            AxisCurveExpanded: [false, false, false]
            ColorMode: [0, 0, 0, 0]
            ColorRandomMin: [0, 0, 0, 0]
            ColorRandomMax: [1, 1, 1, 1]
            ColorCurveExpanded: [false, false, false, false]
            FloatVal: 8
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 50
            Step: 0.200000003
            Tooltip: 沿径向向外喷射速度
            IsExposed: false
            ExposedName: ""
