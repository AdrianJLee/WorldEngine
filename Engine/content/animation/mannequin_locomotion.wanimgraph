# WorldEngine AnimGraph v1 — generic mannequin locomotion showcase
version: 1
name: Mannequin Locomotion
model: engine/models/characters/mannequin.wmodel
initial: Idle
parameter: Speed float 0 0 10 m/s
parameter: Direction float 0 -180 180 deg
parameter: IsFalling bool 0 0 1
parameter: VerticalSpeed float 0 -20 20 m/s
parameter: AimWeight float 0 0 1

state Idle
  kind: clip
  clip: Idle
  loop: true
  speed: 1.0
  transition: Locomotion 0.20 Speed > 0.10
  transition: Jump 0.12 IsFalling > 0.50 && VerticalSpeed > 0.50
  transition: Fall 0.15 IsFalling > 0.50

state Locomotion
  kind: blend2d
  x: Speed
  y: Direction
  sample: 0.0 0 Idle
  sample: 1.6 0 Walk
  sample: 1.6 90 StrafeRight
  sample: 1.6 -90 StrafeLeft
  sample: 1.6 180 WalkBack
  sample: 4.5 0 Run
  sample: 4.5 90 StrafeRight
  sample: 4.5 -90 StrafeLeft
  sample: 4.5 180 WalkBack
  transition: Idle 0.18 Speed < 0.10 && IsFalling < 0.50
  transition: Jump 0.10 IsFalling > 0.50 && VerticalSpeed > 0.50
  transition: Fall 0.12 IsFalling > 0.50

state Jump
  kind: clip
  clip: Jump
  loop: false
  speed: 1.0
  transition: Fall 0.10 VerticalSpeed < 0.50
  transition: Locomotion 0.15 IsFalling < 0.50

state Fall
  kind: clip
  clip: Fall
  loop: true
  speed: 1.0
  transition: Locomotion 0.15 IsFalling < 0.50
  transition: Idle 0.20 Speed < 0.10 && IsFalling < 0.50

layer UpperBody
  clip: Aim
  weight: AimWeight
  mask: Spine 0.25, Chest 1.0, Neck 1.0, Head 1.0, Shoulder.L 1.0, UpperArm.L 1.0, LowerArm.L 1.0, Hand.L 1.0, Shoulder.R 1.0, UpperArm.R 1.0, LowerArm.R 1.0, Hand.R 1.0
