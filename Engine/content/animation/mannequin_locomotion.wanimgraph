# WorldEngine AnimGraph v2 — generic mannequin locomotion showcase
version: 2
name: Mannequin Locomotion
skeleton: engine/models/characters/mannequin.wskeleton
initial: Idle
parameter: Speed float 0 0 10 m/s
parameter: Direction float 0 -180 180 deg
parameter: IsFalling bool 0 0 1
parameter: VerticalSpeed float 0 -20 20 m/s
parameter: AimWeight float 0 0 1

state Idle
  kind: clip
  clip: engine/animation/mannequin_idle.wclip
  loop: true
  speed: 1.0
  transition: Locomotion 0.20 Speed > 0.10
  transition: Jump 0.12 IsFalling > 0.50 && VerticalSpeed > 0.50
  transition: Fall 0.15 IsFalling > 0.50

state Locomotion
  kind: blend2d
  sync_phase: true
  x: Speed
  y: Direction
  sample: 0.0 0 engine/animation/mannequin_idle.wclip
  sample: 1.6 0 engine/animation/mannequin_walk.wclip
  sample: 1.6 90 engine/animation/mannequin_straferight.wclip
  sample: 1.6 -90 engine/animation/mannequin_strafeleft.wclip
  sample: 1.6 180 engine/animation/mannequin_walkback.wclip
  sample: 4.5 0 engine/animation/mannequin_run.wclip
  sample: 4.5 90 engine/animation/mannequin_straferight.wclip
  sample: 4.5 -90 engine/animation/mannequin_strafeleft.wclip
  sample: 4.5 180 engine/animation/mannequin_walkback.wclip
  transition: Idle 0.18 Speed < 0.10 && IsFalling < 0.50
  transition: Jump 0.10 IsFalling > 0.50 && VerticalSpeed > 0.50
  transition: Fall 0.12 IsFalling > 0.50

state Jump
  kind: clip
  clip: engine/animation/mannequin_jump.wclip
  loop: false
  speed: 1.0
  transition: Fall 0.10 VerticalSpeed < 0.50
  transition: Locomotion 0.15 IsFalling < 0.50

state Fall
  kind: clip
  clip: engine/animation/mannequin_fall.wclip
  loop: true
  speed: 1.0
  transition: Locomotion 0.15 IsFalling < 0.50
  transition: Idle 0.20 Speed < 0.10 && IsFalling < 0.50

layer UpperBody
  clip: engine/animation/mannequin_aim.wclip
  weight: AimWeight
  mask_recursive: Spine1 1.0, Spine 1.0
