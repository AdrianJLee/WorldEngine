            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.00999999978
            Max: 20
            Step: 0.0500000007
            Tooltip: 诞生初始尺寸
            IsExposed: true
            ExposedName: SizeStart
          - Name: SizeEnd
            Type: 0
            FloatVal: 0.0399999991
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.00999999978
            Max: 20
