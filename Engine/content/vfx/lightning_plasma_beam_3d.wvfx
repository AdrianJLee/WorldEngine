      KillOnHit: false
      EnableEvents: false
      PlaneOrigin: [0, 0, 0]
      PlaneNormal: [0, 1, 0]
    UseCustomShaderOverride: false
    Modules:
      - Id: mod.emitter.spawn_rate
        Name: 持续发射 (Spawn Rate)
        Description: 控制每秒持续发射的粒子数量 (火焰/浓烟/喷泉/火花流)
        Stage: Emitter
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: SpawnRate]\n    // 由系统发射调度器根据 SpawnRate 与 dt 累积并生成新图元\n"
        Parameters:
          - Name: SpawnRate
            Type: 0
            FloatVal: 60
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
