            Step: 1
            Tooltip: 每秒持续发射粒子数 (/s)
            IsExposed: true
            ExposedName: EmissionRate
      - Id: mod.spawn.init_particle
        Name: 粒子初始化 (Initialize Particle)
        Description: 设定图元诞生时的基准生命周期、初始尺寸与渐变颜色
        Stage: Spawn
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: InitializeParticle]\n    p.MaxLife = u_Lifetime;\n    p.Life = u_Lifetime;\n    p.Size = float2(u_SizeStart);\n    p.Color = u_ColorStart;\n"
        Parameters:
          - Name: Lifetime
            Type: 0
            FloatVal: 0.800000012
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.00999999978
            Max: 99999
            Step: 0.100000001
            Tooltip: 粒子存活基准寿命 (秒)
            IsExposed: true
            ExposedName: Lifetime
          - Name: SizeStart
            Type: 0
            FloatVal: 0.119999997
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.00999999978
            Max: 20
            Step: 0.0500000007
            Tooltip: 诞生初始尺寸
            IsExposed: true
            ExposedName: SizeStart
          - Name: SizeEnd
            Type: 0
            FloatVal: 0.0199999996
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.00999999978
            Max: 20
            Step: 0.0500000007
            Tooltip: 消亡终末尺寸
            IsExposed: true
            ExposedName: SizeEnd
          - Name: ColorStart
            Type: 3
            FloatVal: 0
            VecVal: [1, 0.800000012, 0.300000012, 1]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 0.0500000007
            Tooltip: 初始 RGBA 颜色
            IsExposed: false
            ExposedName: ""
          - Name: ColorEnd
            Type: 3
            FloatVal: 0
            VecVal: [1, 0.200000003, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 0.0500000007
            Tooltip: 消亡 RGBA 颜色
            IsExposed: false
            ExposedName: ""
      - Id: mod.spawn.sphere
        Name: 球体发射 (Sphere Spawn)
        Description: 在 3D 球体表面或体积内均匀随机生成粒子并向外辐射扩散
        Stage: Spawn
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: SphereSpawn] 球面随机分布\n    float z = 1.0f - 2.0f * Hash1D(particleId * 4 + 1);\n    float r = sqrt(max(0.0f, 1.0f - z * z));\n    float phi = 6.2831853f * Hash1D(particleId * 4 + 2);\n    float3 normalDir = float3(r * cos(phi), z, r * sin(phi));\n    p.Position = normalDir * u_SphereRadius;\n    p.Velocity = normalDir * u_OutwardSpeed;\n"
        Parameters:
          - Name: SphereRadius
            Type: 0
            FloatVal: 0.150000006
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.0500000007
            Max: 20
            Step: 0.100000001
            Tooltip: 球体生成半径
            IsExposed: false
            ExposedName: ""
          - Name: OutwardSpeed
            Type: 0
            FloatVal: 9
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 50
            Step: 0.200000003
            Tooltip: 沿径向向外喷射速度
            IsExposed: false
            ExposedName: ""
      - Id: mod.update.gravity
        Name: 重力场 (Gravity Force)
        Description: 对粒子施加恒定三维重力加速度向量
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: GravityForce]\n    p.Velocity += u_Gravity.xyz * dt;\n"
        Parameters:
          - Name: Gravity
            Type: 2
            FloatVal: 0
            VecVal: [0, -8, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: -50
            Max: 50
            Step: 0.200000003
            Tooltip: 三维重力向量 [Gx, Gy, Gz]
            IsExposed: false
            ExposedName: ""
      - Id: mod.update.drag
        Name: 空气阻力 (Air Drag)
        Description: 模拟流体介质空气阻尼，阻碍粒子高速运动
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: LinearDrag]\n    p.Velocity *= max(0.0f, 1.0f - u_LinearDrag * dt);\n"
        Parameters:
          - Name: LinearDrag
            Type: 0
            FloatVal: 0.5
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 10
            Step: 0.0500000007
            Tooltip: 空气阻尼系数
            IsExposed: false
            ExposedName: ""
      - Id: mod.update.solve_velocity
        Name: "物理积分与生命周期 (Solve Velocity & Life)"
        Description: 欧拉物理速度积分更新位置，递减生命周期并计算归一化时间
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: SolveVelocity] 物理欧拉积分与消亡\n    p.Position += p.Velocity * dt;\n    p.Life -= dt;\n    if (u_SpeedDamping > 0.001f)\n        p.Velocity *= max(0.0f, 1.0f - u_SpeedDamping * dt);\n"
        Parameters:
          - Name: SpeedDamping
            Type: 0
            FloatVal: 0
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 5
            Step: 0.0500000007
            Tooltip: 物理速度阻尼
            IsExposed: false
            ExposedName: ""
      - Id: mod.render.sprite
        Name: 精灵渲染器 (Sprite Renderer)
        Description: 配置图元混合模式 (加法/半透)、自发光强度与面片朝向 (相机对齐/水平地面)
        Stage: Render
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: SpriteRenderer]\n    // 驱动 GPU 混合模式与几何着色器面片顶点朝向生成\n"
        Parameters:
          - Name: BlendMode
            Type: 0
            FloatVal: 1
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 1
            Tooltip: 混合模式 (0=半透 AlphaBlend, 1=加法 Additive)
            IsExposed: false
            ExposedName: ""
          - Name: FacingMode
            Type: 0
            FloatVal: 2
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 1
            Tooltip: 面片朝向 (0=Billboard相机对齐, 1=Horizontal地面水平)
            IsExposed: false
            ExposedName: ""
          - Name: EmissiveBoost
            Type: 0
            FloatVal: 4
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.100000001
            Max: 20
            Step: 0.100000001
            Tooltip: HDR 自发光倍率 (促发辉光 Bloom)
            IsExposed: true
            ExposedName: EmissiveBoost