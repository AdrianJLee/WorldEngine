            Step: 0.0500000007
            Tooltip: 初始 RGBA 颜色
            IsExposed: false
            ExposedName: ""
          - Name: ColorEnd
            Type: 3
            FloatVal: 0
            VecVal: [1, 0.200000003, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 0.0500000007
            Tooltip: 消亡 RGBA 颜色
