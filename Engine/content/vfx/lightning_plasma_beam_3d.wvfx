FormatVersion: 1
Name: LightningPlasmaBeam3D
Guid: 0
Seed: 1337
Duration: 4
Looping: true
WarmupTime: 0
LOD:
  CullDistance: 60
  PauseWhenOffscreen: true
Emitters:
  - Name: PlasmaBeamCore
    MaxParticles: 180
    Lifetime: 0.5
    EmissionRate: 140
    EmissionMode: 0
    SingleCount: 1
    Enabled: true
    Emitter:
      Type: Point
      LockToXY: false
      MeshPath: ""
    Material:
      TexturePath: textures/particles/electric_beam.wtex
      MaterialPath: materials/particles/particle_additive.wmat
      BlendMode: Additive
      FacingMode: StretchedVelocity
      EmissiveBoost: 5
      SoftParticle: false
      FadeDistance: 0.5
      SubUV:
        TilesX: 1
        TilesY: 1
        FPS: 0
        RandomStart: false
    Motion:
      Speed: 5
      SpeedVariance: 1
      Gravity: [0, -9.80000019, 0]
      LinearDrag: 0
      VortexStrength: 0
      VortexAxis: [0, 1, 0]
      TurbulenceStrength: 0
      TurbulenceFrequency: 1
    Evolution:
      SizeStart: 0.5
      SizeEnd: 0.100000001
      ColorStart: [1, 1, 1, 1]
      ColorEnd: [1, 1, 1, 0]
    Collision:
      Mode: None
      Restitution: 0.5
      Friction: 0.100000001
      KillOnHit: false
      EnableEvents: false
      PlaneOrigin: [0, 0, 0]
      PlaneNormal: [0, 1, 0]
    UseCustomShaderOverride: false
    Modules:
      - Id: mod.emitter.spawn_rate
        Name: 持续发射 (Spawn Rate)
        Description: 控制每秒持续发射的粒子数量 (火焰/浓烟/喷泉/火花流)
        Stage: Emitter
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: SpawnRate]\n    // 由系统发射调度器根据 SpawnRate 与 dt 累积并生成新图元\n"
        Parameters:
          - Name: SpawnRate
            Type: 0
            FloatVal: 140
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 20000
            Step: 1
            Tooltip: 每秒持续发射粒子数 (/s)
            IsExposed: true
            ExposedName: EmissionRate
      - Id: mod.spawn.init_particle
        Name: 粒子初始化 (Initialize Particle)
        Description: 设定图元诞生时的基准生命周期、初始尺寸与渐变颜色
        Stage: Spawn
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: InitializeParticle]\n    p.MaxLife = u_Lifetime;\n    p.Life = u_Lifetime;\n    p.Size = float2(u_SizeStart);\n    p.Color = u_ColorStart;\n"
        Parameters:
          - Name: Lifetime
            Type: 0
            FloatVal: 0.5
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.00999999978
            Max: 99999
            Step: 0.100000001
            Tooltip: 粒子存活基准寿命 (秒)
            IsExposed: true
            ExposedName: Lifetime
          - Name: SizeStart
            Type: 0
            FloatVal: 0.300000012
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.00999999978
            Max: 20
            Step: 0.0500000007
            Tooltip: 诞生初始尺寸
            IsExposed: true
            ExposedName: SizeStart
          - Name: SizeEnd
            Type: 0
            FloatVal: 0.0799999982
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.00999999978
            Max: 20
            Step: 0.0500000007
            Tooltip: 消亡终末尺寸
            IsExposed: true
            ExposedName: SizeEnd
          - Name: ColorStart
            Type: 3
            FloatVal: 0
            VecVal: [1, 0.800000012, 0.300000012, 1]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 0.0500000007
            Tooltip: 初始 RGBA 颜色
            IsExposed: false
            ExposedName: ""
          - Name: ColorEnd
            Type: 3
            FloatVal: 0
            VecVal: [1, 0.200000003, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 0.0500000007
            Tooltip: 消亡 RGBA 颜色
            IsExposed: false
            ExposedName: ""
      - Id: mod.spawn.point
        Name: 单点发射 (Point Spawn)
        Description: 从单一原点向指定方向发射粒子
        Stage: Spawn
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: PointSpawn]\n    p.Position = float3(0.0f);\n    p.Velocity = float3(0.0f, u_Speed, 0.0f);\n"
        Parameters:
          - Name: Speed
            Type: 0
            FloatVal: 5
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 50
            Step: 0.200000003
            Tooltip: 发射速度
            IsExposed: false
            ExposedName: ""
      - Id: mod.update.solve_velocity
        Name: "物理积分与生命周期 (Solve Velocity & Life)"
        Description: 欧拉物理速度积分更新位置，递减生命周期并计算归一化时间
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: SolveVelocity] 物理欧拉积分与消亡\n    p.Position += p.Velocity * dt;\n    p.Life -= dt;\n    if (u_SpeedDamping > 0.001f)\n        p.Velocity *= max(0.0f, 1.0f - u_SpeedDamping * dt);\n"
        Parameters:
          - Name: SpeedDamping
            Type: 0
            FloatVal: 0
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 5
            Step: 0.0500000007
            Tooltip: 物理速度阻尼
            IsExposed: false
            ExposedName: ""
      - Id: mod.render.sprite
        Name: 精灵渲染器 (Sprite Renderer)
        Description: 配置图元混合模式 (加法/半透)、自发光强度与面片朝向 (相机对齐/水平地面)
        Stage: Render
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: SpriteRenderer]\n    // 驱动 GPU 混合模式与几何着色器面片顶点朝向生成\n"
        Parameters:
          - Name: BlendMode
            Type: 0
            FloatVal: 1
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 1
            Tooltip: 混合模式 (0=半透 AlphaBlend, 1=加法 Additive)
            IsExposed: false
            ExposedName: ""
          - Name: FacingMode
            Type: 0
            FloatVal: 2
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 1
            Tooltip: 面片朝向 (0=Billboard相机对齐, 1=Horizontal地面水平)
            IsExposed: false
            ExposedName: ""
          - Name: EmissiveBoost
            Type: 0
            FloatVal: 5
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.100000001
            Max: 20
            Step: 0.100000001
            Tooltip: HDR 自发光倍率 (促发辉光 Bloom)
            IsExposed: true
            ExposedName: EmissiveBoost
  - Name: ElectricArcJitter
