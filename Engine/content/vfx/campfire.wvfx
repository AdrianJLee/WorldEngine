FormatVersion: 1
Name: Campfire
Guid: 0
Seed: 1337
Duration: 4
Looping: true
WarmupTime: 0
LOD:
  CullDistance: 60
  PauseWhenOffscreen: true
Emitters:
  - Name: CampfireFlame
    MaxParticles: 200
    Lifetime: 1.20000005
    EmissionRate: 45
    EmissionMode: 0
    SingleCount: 1
    Enabled: true
    Emitter:
      Type: Point
      LockToXY: false
      MeshPath: ""
    Material:
      TexturePath: textures/particles/fire_flipbook_4x4.wtex
      MaterialPath: materials/particles/particle_additive.wmat
      BlendMode: Additive
      FacingMode: Billboard
      EmissiveBoost: 3.20000005
      SoftParticle: false
      FadeDistance: 0.5
      SubUV:
        TilesX: 4
        TilesY: 4
        FPS: 0
        RandomStart: false
    Motion:
      Speed: 5
      SpeedVariance: 1
      Gravity: [0, -9.80000019, 0]
      LinearDrag: 0
      VortexStrength: 0
      VortexAxis: [0, 1, 0]
      TurbulenceStrength: 0
      TurbulenceFrequency: 1
    Evolution:
      SizeStart: 0.5
      SizeEnd: 0.100000001
      ColorStart: [1, 1, 1, 1]
      ColorEnd: [1, 1, 1, 0]
    Collision:
      Mode: None
      Restitution: 0.5
      Friction: 0.100000001
      KillOnHit: false
      EnableEvents: false
      PlaneOrigin: [0, 0, 0]
      PlaneNormal: [0, 1, 0]
    UseCustomShaderOverride: false
    Modules:
      - Id: mod.emitter.spawn_rate
        Name: 持续发射 (Spawn Rate)
        Description: 控制每秒持续发射的粒子数量 (火焰/浓烟/喷泉/火花流)
        Stage: Emitter
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: SpawnRate]\n    // 由系统发射调度器根据 SpawnRate 与 dt 累积并生成新图元\n"
        Parameters:
          - Name: SpawnRate
            Type: 0
            FloatVal: 45
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 20000
            Step: 1
            Tooltip: 每秒持续发射粒子数 (/s)
            IsExposed: true
            ExposedName: EmissionRate
      - Id: mod.spawn.init_particle
        Name: 粒子初始化 (Initialize Particle)
        Description: 设定图元诞生时的基准生命周期、初始尺寸与渐变颜色
        Stage: Spawn
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: InitializeParticle]\n    p.MaxLife = u_Lifetime;\n    p.Life = u_Lifetime;\n    p.Size = float2(u_SizeStart);\n    p.Color = u_ColorStart;\n"
        Parameters:
          - Name: Lifetime
            Type: 0
            FloatVal: 1.20000005
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.00999999978
            Max: 99999
            Step: 0.100000001
            Tooltip: 粒子存活基准寿命 (秒)
            IsExposed: true
            ExposedName: Lifetime
          - Name: SizeStart
            Type: 0
            FloatVal: 0.449999988
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.00999999978
            Max: 20
            Step: 0.0500000007
            Tooltip: 诞生初始尺寸
            IsExposed: true
            ExposedName: SizeStart
          - Name: SizeEnd
            Type: 0
            FloatVal: 0.150000006
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.00999999978
            Max: 20
            Step: 0.0500000007
            Tooltip: 消亡终末尺寸
            IsExposed: true
            ExposedName: SizeEnd
          - Name: ColorStart
            Type: 3
            FloatVal: 0
            VecVal: [1, 0.800000012, 0.300000012, 1]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 0.0500000007
            Tooltip: 初始 RGBA 颜色
            IsExposed: false
            ExposedName: ""
          - Name: ColorEnd
            Type: 3
            FloatVal: 0
            VecVal: [1, 0.200000003, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 0.0500000007
            Tooltip: 消亡 RGBA 颜色
            IsExposed: false
            ExposedName: ""
      - Id: mod.spawn.cone
        Name: 圆锥发射 (Cone Spawn)
        Description: 按圆锥顶角与底面半径空间分布发射粒子并赋予初始初速度
        Stage: Spawn
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: ConeSpawn] 圆锥发射空间分布算法\n    float angleRad = radians(u_ConeAngle);\n    float u = Hash1D(particleId * 3 + 1);\n    float v = Hash1D(particleId * 3 + 2);\n    float phi = 6.2831853f * u;\n    float sinTheta = sin(angleRad) * sqrt(v);\n    float cosTheta = sqrt(max(0.0f, 1.0f - sinTheta * sinTheta));\n    float3 localDir = float3(sinTheta * cos(phi), cosTheta, sinTheta * sin(phi));\n    \n    float diskR = u_ConeRadius * sqrt(Hash1D(particleId * 3 + 0));\n    float diskPhi = 6.2831853f * Hash1D(particleId * 3 + 7);\n    p.Position = float3(diskR * cos(diskPhi), 0.0f, diskR * sin(diskPhi));\n    \n    float speed = u_InitialSpeed + (Hash1D(particleId * 7 + 3) * 2.0f - 1.0f) * u_SpeedVariance;\n    p.Velocity = localDir * speed;\n"
        Parameters:
          - Name: ConeAngle
            Type: 0
            FloatVal: 12
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 90
            Step: 1
            Tooltip: 圆锥半角 (度)
            IsExposed: false
            ExposedName: ""
          - Name: ConeRadius
            Type: 0
            FloatVal: 0.180000007
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 10
            Step: 0.0500000007
            Tooltip: 底部圆盘半径 (米)
            IsExposed: false
            ExposedName: ""
          - Name: InitialSpeed
            Type: 0
            FloatVal: 1.60000002
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 50
            Step: 0.200000003
            Tooltip: 发射初始基准速率 (m/s)
            IsExposed: false
            ExposedName: ""
          - Name: SpeedVariance
            Type: 0
            FloatVal: 1
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 20
            Step: 0.100000001
            Tooltip: 发射速度随机扰动范围
            IsExposed: false
            ExposedName: ""
      - Id: mod.update.gravity
        Name: 重力场 (Gravity Force)
        Description: 对粒子施加恒定三维重力加速度向量
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: GravityForce]\n    p.Velocity += u_Gravity.xyz * dt;\n"
        Parameters:
          - Name: Gravity
            Type: 2
            FloatVal: 0
            VecVal: [0, 3.20000005, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: -50
            Max: 50
            Step: 0.200000003
            Tooltip: 三维重力向量 [Gx, Gy, Gz]
            IsExposed: false
            ExposedName: ""
      - Id: mod.update.curl_noise
        Name: 3D 旋度噪声场 (Curl Noise Turbulence)
        Description: 基于无散度 3D 旋度噪声向量场驱动真实的流体涡流混沌运动
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: CurlNoiseTurbulence] 3D 无散度流体涡流场\n    float3 curl = CurlNoise3D(p.Position * u_NoiseFrequency);\n    p.Velocity += curl * (u_NoiseStrength * dt);\n"
        Parameters:
          - Name: NoiseStrength
            Type: 0
            FloatVal: 2
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 30
            Step: 0.200000003
            Tooltip: 噪声场作用力强度
            IsExposed: true
            ExposedName: TurbulenceStrength
          - Name: NoiseFrequency
            Type: 0
            FloatVal: 1.20000005
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.0500000007
            Max: 10
            Step: 0.0500000007
            Tooltip: 空间采样频率 (波长缩放)
            IsExposed: false
            ExposedName: ""
      - Id: mod.render.flipbook
        Name: 序列帧动画驱动 (SubUV Flipbook)
        Description: 按时间或存活进度步进 UV 帧切片序号 (支持 4x4 火焰、烟雾爆破)
        Stage: Render
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: Flipbook]\n    // 由 CPU 与 GPU 渲染器根据 TilesX/TilesY 驱动 SubUVFrameIndex\n"
        Parameters:
          - Name: TilesX
            Type: 0
            FloatVal: 4
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 1
            Max: 16
            Step: 1
            Tooltip: 横向切片列数
            IsExposed: false
            ExposedName: ""
          - Name: TilesY
            Type: 0
            FloatVal: 4
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 1
            Max: 16
            Step: 1
            Tooltip: 纵向切片行数
            IsExposed: false
            ExposedName: ""
          - Name: FPS
            Type: 0
            FloatVal: 16
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 1
            Max: 60
            Step: 1
            Tooltip: 帧率播放速度
            IsExposed: false
            ExposedName: ""
          - Name: AnimationMode
            Type: 0
            FloatVal: 0
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 1
            Tooltip: 动画模式 (0=FPS循环, 1=随寿命单次归一化)
            IsExposed: false
            ExposedName: ""
      - Id: mod.update.scale_over_life
        Name: 尺寸随寿命缩放 (Scale Over Life)
        Description: 基于归一化存活进度 (0~1) 控制粒子尺寸膨胀扩散或缩小消亡
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: Scale Over Life]\n    float normLife = clamp(1.0f - (p.Life / max(0.001f, p.MaxLife)), 0.0f, 1.0f);\n    p.Size = lerp(u_StartScale, u_EndScale, normLife);\n"
        Parameters:
          - Name: StartScale
            Type: 0
            FloatVal: 0.449999988
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 20
            Step: 0.0500000007
            Tooltip: 初始尺寸乘子
            IsExposed: false
            ExposedName: ""
          - Name: EndScale
            Type: 0
            FloatVal: 0.150000006
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 20
            Step: 0.0500000007
            Tooltip: 消亡前终止尺寸乘子
            IsExposed: false
            ExposedName: ""
      - Id: mod.update.color_over_life
        Name: 色彩淡入淡出 (Color Over Life)
        Description: 基于粒子存活进度进行色彩与透明度渐变过渡
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: Color Over Life]\n    float normLife = clamp(1.0f - (p.Life / max(0.001f, p.MaxLife)), 0.0f, 1.0f);\n    p.Color = lerp(u_ColorStart, u_ColorEnd, normLife);\n"
        Parameters:
          - Name: ColorStart
            Type: 3
            FloatVal: 1
            VecVal: [1, 0.850000024, 0.300000012, 1]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 0.00999999978
            Tooltip: 初始出生颜色 (RGBA)
            IsExposed: false
            ExposedName: ""
          - Name: ColorEnd
            Type: 3
            FloatVal: 1
            VecVal: [0.899999976, 0.150000006, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 0.00999999978
            Tooltip: 终止消亡颜色 (RGBA)
            IsExposed: false
            ExposedName: ""
      - Id: mod.update.solve_velocity
        Name: "物理积分与生命周期 (Solve Velocity & Life)"
        Description: 欧拉物理速度积分更新位置，递减生命周期并计算归一化时间
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: SolveVelocity] 物理欧拉积分与消亡\n    p.Position += p.Velocity * dt;\n    p.Life -= dt;\n    if (u_SpeedDamping > 0.001f)\n        p.Velocity *= max(0.0f, 1.0f - u_SpeedDamping * dt);\n"
        Parameters:
          - Name: SpeedDamping
            Type: 0
            FloatVal: 0
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 5
            Step: 0.0500000007
            Tooltip: 物理速度阻尼
            IsExposed: false
            ExposedName: ""
      - Id: mod.render.sprite
        Name: 精灵渲染器 (Sprite Renderer)
        Description: 配置图元混合模式 (加法/半透)、自发光强度与面片朝向 (相机对齐/水平地面)
        Stage: Render
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: SpriteRenderer]\n    // 驱动 GPU 混合模式与几何着色器面片顶点朝向生成\n"
        Parameters:
          - Name: BlendMode
            Type: 0
            FloatVal: 1
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 1
            Tooltip: 混合模式 (0=半透 AlphaBlend, 1=加法 Additive)
            IsExposed: false
            ExposedName: ""
          - Name: FacingMode
            Type: 0
            FloatVal: 0
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 1
            Tooltip: 面片朝向 (0=Billboard相机对齐, 1=Horizontal地面水平)
            IsExposed: false
            ExposedName: ""
          - Name: EmissiveBoost
            Type: 0
            FloatVal: 3.20000005
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.100000001
            Max: 20
            Step: 0.100000001
            Tooltip: HDR 自发光倍率 (促发辉光 Bloom)
            IsExposed: true
            ExposedName: EmissiveBoost
  - Name: RisingSmoke
    MaxParticles: 100
    Lifetime: 3
    EmissionRate: 18
    EmissionMode: 0
    SingleCount: 1
    Enabled: true
    Emitter:
      Type: Point
