        IsCustom: false
        SlangSource: "\n    // [Module: SpriteRenderer]\n    // 驱动 GPU 混合模式与几何着色器面片顶点朝向生成\n"
        Parameters:
          - Name: BlendMode
            Type: 0
            FloatVal: 0
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 1
            Tooltip: 混合模式 (0=半透 AlphaBlend, 1=加法 Additive)
            IsExposed: false
            ExposedName: ""
          - Name: FacingMode
            Type: 0
            FloatVal: 0
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 1
            Tooltip: 面片朝向 (0=Billboard相机对齐, 1=Horizontal地面水平)
            IsExposed: false
            ExposedName: ""
          - Name: EmissiveBoost
            Type: 0
            FloatVal: 0.800000012
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.100000001
            Max: 20
            Step: 0.100000001
            Tooltip: HDR 自发光倍率 (促发辉光 Bloom)
            IsExposed: true
            ExposedName: EmissiveBoost
