      ColorStart: [1, 1, 1, 1]
      ColorEnd: [1, 1, 1, 0]
    Collision:
      Mode: None
      Restitution: 0.5
      Friction: 0.100000001
      KillOnHit: false
      EnableEvents: false
      PlaneOrigin: [0, 0, 0]
      PlaneNormal: [0, 1, 0]
    UseCustomShaderOverride: false
    Modules:
