      Friction: 0.100000001
      KillOnHit: false
      EnableEvents: false
      PlaneOrigin: [0, 0, 0]
      PlaneNormal: [0, 1, 0]
    UseCustomShaderOverride: false
    Modules:
      - Id: mod.emitter.spawn_rate
        Name: 持续发射 (Spawn Rate)
        Description: 控制每秒持续发射的粒子数量与最大粒子容量 (火焰/浓烟/喷泉/火花流)
        Stage: Emitter
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: SpawnRate]\n    // 由系统发射调度器根据 SpawnRate 与 dt 累积并生成新图元\n"
        Parameters:
          - Name: SpawnRate
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 60
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 20000
            Step: 1
            Tooltip: 每秒持续发射粒子数 (/s)
            IsExposed: true
            ExposedName: EmissionRate
          - Name: MaxParticles
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 500
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 1
            Max: 100000
            Step: 10
            Tooltip: 最大粒子容量 (Max Particles)
            IsExposed: true
            ExposedName: MaxParticles
      - Id: mod.spawn.init_particle
        Name: 粒子初始化 (Initialize Particle)
        Description: 设定图元诞生时的基准生命周期、初始尺寸与渐变颜色
        Stage: Spawn
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: InitializeParticle]\n    p.MaxLife = u_Lifetime;\n    p.Life = u_Lifetime;\n    p.Size = float2(u_SizeStart);\n    p.Color = u_ColorStart;\n"
        Parameters:
          - Name: Lifetime
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 2.20000005
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.00999999978
            Max: 99999
            Step: 0.100000001
            Tooltip: 粒子存活基准寿命 (秒)
            IsExposed: true
            ExposedName: Lifetime
          - Name: SizeStart
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 0.349999994
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.00999999978
            Max: 20
            Step: 0.0500000007
            Tooltip: 诞生初始尺寸
            IsExposed: true
