FormatVersion: 1
Name: BlizzardFrostNova3D
Guid: 0
Seed: 1337
Duration: 5
Looping: true
WarmupTime: 0
LOD:
  CullDistance: 60
  PauseWhenOffscreen: true
Emitters:
  - Name: FrostBlastRing
    MaxParticles: 1
    Lifetime: 1.5
    EmissionRate: 0
    EmitterDuration: 0
    EmitterLooping: true
    EmissionMode: 0
    SingleCount: 1
    Enabled: true
    Emitter:
      Type: Point
      LockToXY: false
      MeshPath: ""
    Material:
      TexturePath: textures/particles/shockwave_ring.wtex
      MaterialPath: materials/particles/particle_additive.wmat
      BlendMode: Additive
      FacingMode: HorizontalQuad
      EmissiveBoost: 3.5
      SoftParticle: false
      FadeDistance: 0.5
      SubUV:
        TilesX: 1
        TilesY: 1
        FPS: 0
        RandomStart: false
    Motion:
      Speed: 5
      SpeedVariance: 1
      Gravity: [0, -9.80000019, 0]
      LinearDrag: 0
      VortexStrength: 0
      VortexAxis: [0, 1, 0]
      TurbulenceStrength: 0
      TurbulenceFrequency: 1
    Evolution:
      SizeStart: 0.5
      SizeEnd: 0.100000001
      ColorStart: [1, 1, 1, 1]
      ColorEnd: [1, 1, 1, 0]
    Collision:
      Mode: None
      Restitution: 0.5
      Friction: 0.100000001
      KillOnHit: false
      EnableEvents: false
      PlaneOrigin: [0, 0, 0]
      PlaneNormal: [0, 1, 0]
    Bursts:
      - Time: 0
        Count: 1
    UseCustomShaderOverride: false
    Modules:
      - Id: mod.emitter.spawn_burst
        Name: 瞬态爆发/单体 (Spawn Burst)
        Description: 在指定时间瞬间爆发生成固定数量图元 (Count=1 用于法阵/护盾/光环，零发射流开销)
        Stage: Emitter
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: SpawnBurst]\n    // 在指定时间瞬间生成指定数量的粒子或单体网格图元\n"
        Parameters:
          - Name: SpawnCount
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 1
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 1
            Max: 10000
            Step: 1
            Tooltip: 瞬时生成图元数量 (1 为单体法阵/护盾)
            IsExposed: true
            ExposedName: BurstCount
          - Name: SpawnTime
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 0
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 99999
            Step: 0.100000001
            Tooltip: 爆发触发时间 (秒)
            IsExposed: false
            ExposedName: ""
          - Name: MaxParticles
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 500
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 1
            Max: 100000
            Step: 10
            Tooltip: 最大粒子容量 (Max Particles)
            IsExposed: true
            ExposedName: MaxParticles
      - Id: mod.spawn.init_particle
        Name: 粒子初始化 (Initialize Particle)
        Description: 设定图元诞生时的基准生命周期、初始尺寸与渐变颜色
        Stage: Spawn
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: InitializeParticle]\n    p.MaxLife = u_Lifetime;\n    p.Life = u_Lifetime;\n    p.Size = float2(u_SizeStart);\n    p.Color = u_ColorStart;\n"
        Parameters:
          - Name: Lifetime
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 1.5
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.00999999978
            Max: 99999
            Step: 0.100000001
            Tooltip: 粒子存活基准寿命 (秒)
            IsExposed: true
            ExposedName: Lifetime
          - Name: SizeStart
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 0.5
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.00999999978
            Max: 20
            Step: 0.0500000007
            Tooltip: 诞生初始尺寸
            IsExposed: true
            ExposedName: SizeStart
          - Name: SizeEnd
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 7
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.00999999978
            Max: 20
            Step: 0.0500000007
            Tooltip: 消亡终末尺寸
            IsExposed: true
            ExposedName: SizeEnd
          - Name: ColorStart
            Type: 3
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 0
            VecVal: [1, 0.800000012, 0.300000012, 1]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 0.0500000007
            Tooltip: 初始 RGBA 颜色
            IsExposed: false
            ExposedName: ""
          - Name: ColorEnd
            Type: 3
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 0
            VecVal: [1, 0.200000003, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 0.0500000007
            Tooltip: 消亡 RGBA 颜色
            IsExposed: false
            ExposedName: ""
      - Id: mod.spawn.point
        Name: 单点发射 (Point Spawn)
        Description: 从单一原点向指定方向发射粒子
        Stage: Spawn
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: PointSpawn]\n    p.Position = float3(0.0f);\n    p.Velocity = float3(0.0f, u_Speed, 0.0f);\n"
        Parameters:
          - Name: Speed
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 5
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 50
            Step: 0.200000003
            Tooltip: 发射速度
            IsExposed: false
            ExposedName: ""
      - Id: mod.update.shockwave_expansion
        Name: 冲击波扩散衰减 (Shockwave Expansion)
        Description: 模拟地表冲击波光环从原点快速径向扩张扩散，并伴随缓出透明度衰减
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: Shockwave Expansion]\n    float normLife = clamp(1.0f - (p.Life / max(0.001f, p.MaxLife)), 0.0f, 1.0f);\n    p.Size = float2(lerp(0.5f, u_MaxRadius, sqrt(normLife)));\n    p.Color.a *= max(0.0f, 1.0f - normLife * u_DissipationRate);\n"
        Parameters:
          - Name: ExpansionSpeed
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 6
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.100000001
            Max: 30
            Step: 0.200000003
            Tooltip: 冲击波尺寸扩张速率 (m/s)
            IsExposed: false
            ExposedName: ""
          - Name: MaxRadius
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 7
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.5
            Max: 50
            Step: 0.5
            Tooltip: 最大扩散外圈尺寸
            IsExposed: false
            ExposedName: ""
          - Name: DissipationRate
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 1.20000005
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 10
            Step: 0.100000001
            Tooltip: 透明度衰减消散速率
            IsExposed: false
            ExposedName: ""
      - Id: mod.update.color_over_life
        Name: 色彩淡入淡出 (Color Over Life)
        Description: 基于粒子存活进度进行色彩与透明度渐变过渡
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: Color Over Life]\n    float normLife = clamp(1.0f - (p.Life / max(0.001f, p.MaxLife)), 0.0f, 1.0f);\n    p.Color = lerp(u_ColorStart, u_ColorEnd, normLife);\n"
        Parameters:
          - Name: ColorStart
            Type: 3
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 1
            VecVal: [0.600000024, 0.899999976, 1, 1]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 0.00999999978
            Tooltip: 初始出生颜色 (RGBA)
            IsExposed: false
            ExposedName: ""
          - Name: ColorEnd
            Type: 3
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 1
            VecVal: [0.100000001, 0.400000006, 0.800000012, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 0.00999999978
            Tooltip: 终止消亡颜色 (RGBA)
            IsExposed: false
            ExposedName: ""
      - Id: mod.update.solve_velocity
        Name: "物理积分与生命周期 (Solve Velocity & Life)"
        Description: 欧拉物理速度积分更新位置，递减生命周期并计算归一化时间
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: SolveVelocity] 物理欧拉积分与消亡\n    p.Position += p.Velocity * dt;\n    p.Life -= dt;\n    if (u_SpeedDamping > 0.001f)\n        p.Velocity *= max(0.0f, 1.0f - u_SpeedDamping * dt);\n"
        Parameters:
          - Name: SpeedDamping
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 0
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 5
            Step: 0.0500000007
            Tooltip: 物理速度阻尼
            IsExposed: false
            ExposedName: ""
      - Id: mod.render.sprite
        Name: 精灵渲染器 (Sprite Renderer)
        Description: 配置图元混合模式 (加法/半透)、自发光强度与面片朝向 (相机对齐/水平地面)
        Stage: Render
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: SpriteRenderer]\n    // 驱动 GPU 混合模式与几何着色器面片顶点朝向生成\n"
        Parameters:
          - Name: BlendMode
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 1
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 1
            Tooltip: 混合模式 (0=半透 AlphaBlend, 1=加法 Additive)
            IsExposed: false
            ExposedName: ""
          - Name: FacingMode
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 1
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 1
            Tooltip: 面片朝向 (0=Billboard相机对齐, 1=Horizontal地面水平)
            IsExposed: false
            ExposedName: ""
          - Name: EmissiveBoost
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 3.5
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.100000001
            Max: 20
            Step: 0.100000001
            Tooltip: HDR 自发光倍率 (促发辉光 Bloom)
            IsExposed: true
            ExposedName: EmissiveBoost
  - Name: HexagonalIceCrystals
    MaxParticles: 120
