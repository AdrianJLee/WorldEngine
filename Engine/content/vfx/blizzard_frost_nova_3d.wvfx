    Motion:
      Speed: 5
      SpeedVariance: 1
      Gravity: [0, -9.80000019, 0]
      LinearDrag: 0
      VortexStrength: 0
      VortexAxis: [0, 1, 0]
      TurbulenceStrength: 0
      TurbulenceFrequency: 1
    Evolution:
      SizeStart: 0.5
