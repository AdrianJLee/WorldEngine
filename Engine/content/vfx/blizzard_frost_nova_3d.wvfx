            RandomMin: 0
            RandomMax: 1
            FloatVal: 0
            VecVal: [1, 0.800000012, 0.300000012, 1]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 0.0500000007
            Tooltip: 初始 RGBA 颜色
            IsExposed: false
            ExposedName: ""
          - Name: ColorEnd
            Type: 3
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 0
            VecVal: [1, 0.200000003, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 0.0500000007
            Tooltip: 消亡 RGBA 颜色
            IsExposed: false
            ExposedName: ""
      - Id: mod.spawn.ring
        Name: 圆环发射 (Ring Spawn)
        Description: 在 3D 水平圆环边缘几何分布生成粒子 (法阵/护盾/光环/冰霜新星)
        Stage: Spawn
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: RingSpawn] 水平圆环边缘几何分布\n    float u = Hash1D(particleId * 11u + 3u);\n    float phi = 6.2831853f * u;\n    p.Position = float3(cos(phi) * u_RingRadius, 0.0f, sin(phi) * u_RingRadius);\n    p.Velocity = float3(0.0f, u_InitialSpeed, 0.0f);\n"
        Parameters:
          - Name: RingRadius
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 0.5
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.100000001
            Max: 20
            Step: 0.100000001
            Tooltip: 圆环生成半径 (m)
            IsExposed: false
            ExposedName: ""
          - Name: InitialSpeed
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 0.300000012
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 50
            Step: 0.200000003
            Tooltip: 垂直发射速率 (m/s)
            IsExposed: false
            ExposedName: ""
      - Id: mod.update.orbit
        Name: 中心轴轨道公转 (Orbit Around Center)
        Description: 围绕指定空间中心点与旋转轴进行稳定圆周轨道旋转运动 (护盾/光环/符文)
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: Orbit Around Center]\n    float3 toCenter = p.Position - u_OrbitCenter.xyz;\n    float dist = length(toCenter);\n    if (dist > 0.01f)\n    {\n        float3 tangent = cross(u_OrbitAxis.xyz, normalize(toCenter));\n        p.Velocity = tangent * u_OrbitSpeed;\n    }\n"
        Parameters:
          - Name: OrbitSpeed
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 2.5
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: -30
            Max: 30
            Step: 0.200000003
            Tooltip: 轨道公转切向角速率
            IsExposed: false
            ExposedName: ""
          - Name: OrbitAxis
            Type: 2
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 1
            VecVal: [0, 1, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: -1
            Max: 1
            Step: 0.100000001
            Tooltip: 公转旋转主轴
            IsExposed: false
            ExposedName: ""
          - Name: OrbitCenter
            Type: 2
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 1
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: -50
            Max: 50
            Step: 0.5
            Tooltip: 空间轨道几何中心点
            IsExposed: false
            ExposedName: ""
      - Id: mod.update.rotation_over_life
        Name: 平面旋转与角速度 (Rotation Over Life)
        Description: 控制粒子初始旋转朝向与随寿命演进的持续角速度 (rad/s)
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: Rotation Over Life]\n    p.Rotation += u_RotationSpeed * dt;\n"
        Parameters:
          - Name: RotationSpeed
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 2.5
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: -30
            Max: 30
            Step: 0.100000001
            Tooltip: 自转角速度 (rad/s)
            IsExposed: false
            ExposedName: ""
          - Name: InitialRotation
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 0
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: -3.14159012
            Max: 3.14159012
            Step: 0.0500000007
            Tooltip: 初始旋转角度 (rad)
            IsExposed: false
            ExposedName: ""
      - Id: mod.update.drag
        Name: 空气阻力 (Air Drag)
        Description: 模拟流体介质空气阻尼，阻碍粒子高速运动
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: LinearDrag]\n    p.Velocity *= max(0.0f, 1.0f - u_LinearDrag * dt);\n"
        Parameters:
          - Name: LinearDrag
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 0.400000006
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 10
            Step: 0.0500000007
            Tooltip: 空气阻尼系数
            IsExposed: false
            ExposedName: ""
      - Id: mod.update.color_over_life
        Name: 色彩淡入淡出 (Color Over Life)
        Description: 基于粒子存活进度进行色彩与透明度渐变过渡
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: Color Over Life]\n    float normLife = clamp(1.0f - (p.Life / max(0.001f, p.MaxLife)), 0.0f, 1.0f);\n    p.Color = lerp(u_ColorStart, u_ColorEnd, normLife);\n"
        Parameters:
          - Name: ColorStart
            Type: 3
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 1
            VecVal: [0.800000012, 0.949999988, 1, 1]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 0.00999999978
            Tooltip: 初始出生颜色 (RGBA)
            IsExposed: false
            ExposedName: ""
          - Name: ColorEnd
            Type: 3
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 1
            VecVal: [0.300000012, 0.699999988, 1, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 0.00999999978
            Tooltip: 终止消亡颜色 (RGBA)
            IsExposed: false
            ExposedName: ""
      - Id: mod.update.solve_velocity
        Name: "物理积分与生命周期 (Solve Velocity & Life)"
        Description: 欧拉物理速度积分更新位置，递减生命周期并计算归一化时间
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: SolveVelocity] 物理欧拉积分与消亡\n    p.Position += p.Velocity * dt;\n    p.Life -= dt;\n    if (u_SpeedDamping > 0.001f)\n        p.Velocity *= max(0.0f, 1.0f - u_SpeedDamping * dt);\n"
        Parameters:
          - Name: SpeedDamping
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 0
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 5
            Step: 0.0500000007
            Tooltip: 物理速度阻尼
            IsExposed: false
            ExposedName: ""
      - Id: mod.render.sprite
        Name: 精灵渲染器 (Sprite Renderer)
        Description: 配置图元混合模式 (加法/半透)、自发光强度与面片朝向 (相机对齐/水平地面)
        Stage: Render
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: SpriteRenderer]\n    // 驱动 GPU 混合模式与几何着色器面片顶点朝向生成\n"
        Parameters:
          - Name: BlendMode
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
