            RandomMax: 1
            FloatVal: 0
            VecVal: [1, 0.200000003, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 0.0500000007
            Tooltip: 消亡 RGBA 颜色
            IsExposed: false
            ExposedName: ""
      - Id: mod.spawn.ring
        Name: 圆环发射 (Ring Spawn)
        Description: 在 3D 水平圆环边缘几何分布生成粒子 (法阵/护盾/光环/冰霜新星)
        Stage: Spawn
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: RingSpawn] 水平圆环边缘几何分布\n    float u = Hash1D(particleId * 11u + 3u);\n    float phi = 6.2831853f * u;\n    p.Position = float3(cos(phi) * u_RingRadius, 0.0f, sin(phi) * u_RingRadius);\n    p.Velocity = float3(0.0f, u_InitialSpeed, 0.0f);\n"
        Parameters:
          - Name: RingRadius
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 1.5
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.100000001
            Max: 20
            Step: 0.100000001
            Tooltip: 圆环生成半径 (m)
            IsExposed: false
            ExposedName: ""
          - Name: InitialSpeed
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 0.100000001
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 50
            Step: 0.200000003
            Tooltip: 垂直发射速率 (m/s)
            IsExposed: false
            ExposedName: ""
      - Id: mod.update.vortex
        Name: 轴向旋转涡流 (Vortex Field)
        Description: 围绕指定三维轴线驱动粒子做切向飞旋龙卷运动
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: VortexField] 轴向切向旋转\n    float3 normAxis = normalize(u_VortexAxis.xyz);\n    float3 tangential = cross(normAxis, p.Position);\n    p.Velocity += tangential * (u_VortexStrength * dt);\n"
        Parameters:
          - Name: VortexAxis
            Type: 2
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 0
            VecVal: [0, 1, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: -1
            Max: 1
            Step: 0.0500000007
            Tooltip: 涡流旋转轴向量
            IsExposed: false
            ExposedName: ""
          - Name: VortexStrength
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 2
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: -30
            Max: 30
            Step: 0.200000003
            Tooltip: 旋转切向角速度强度
            IsExposed: false
            ExposedName: ""
      - Id: mod.update.rotation_over_life
        Name: 平面旋转与角速度 (Rotation Over Life)
        Description: 控制粒子初始旋转朝向与随寿命演进的持续角速度 (rad/s)
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: Rotation Over Life]\n    p.Rotation += u_RotationSpeed * dt;\n"
        Parameters:
          - Name: RotationSpeed
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 0.5
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: -30
            Max: 30
            Step: 0.100000001
            Tooltip: 自转角速度 (rad/s)
            IsExposed: false
            ExposedName: ""
          - Name: InitialRotation
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 0
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: -3.14159012
            Max: 3.14159012
            Step: 0.0500000007
            Tooltip: 初始旋转角度 (rad)
            IsExposed: false
            ExposedName: ""
      - Id: mod.update.scale_over_life
        Name: 尺寸随寿命缩放 (Scale Over Life)
        Description: 基于归一化存活进度 (0~1) 控制粒子尺寸膨胀扩散或缩小消亡
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: Scale Over Life]\n    float normLife = clamp(1.0f - (p.Life / max(0.001f, p.MaxLife)), 0.0f, 1.0f);\n    p.Size = lerp(u_StartScale, u_EndScale, normLife);\n"
        Parameters:
          - Name: StartScale
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 0.600000024
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 20
            Step: 0.0500000007
            Tooltip: 初始尺寸乘子
            IsExposed: false
            ExposedName: ""
          - Name: EndScale
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 2.5
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 20
            Step: 0.0500000007
            Tooltip: 消亡前终止尺寸乘子
            IsExposed: false
            ExposedName: ""
      - Id: mod.update.color_over_life
        Name: 色彩淡入淡出 (Color Over Life)
        Description: 基于粒子存活进度进行色彩与透明度渐变过渡
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: Color Over Life]\n    float normLife = clamp(1.0f - (p.Life / max(0.001f, p.MaxLife)), 0.0f, 1.0f);\n    p.Color = lerp(u_ColorStart, u_ColorEnd, normLife);\n"
        Parameters:
          - Name: ColorStart
            Type: 3
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 1
            VecVal: [0.600000024, 0.800000012, 0.949999988, 0.449999988]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 0.00999999978
            Tooltip: 初始出生颜色 (RGBA)
            IsExposed: false
            ExposedName: ""
          - Name: ColorEnd
            Type: 3
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 1
            VecVal: [0.400000006, 0.600000024, 0.899999976, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 0.00999999978
            Tooltip: 终止消亡颜色 (RGBA)
            IsExposed: false
            ExposedName: ""
