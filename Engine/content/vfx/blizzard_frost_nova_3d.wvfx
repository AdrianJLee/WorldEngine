  - Name: SubZeroFog
    MaxParticles: 120
    Lifetime: 2.5
    EmissionRate: 30
    EmitterDuration: 0
    EmitterLooping: true
    EmissionMode: 0
    SingleCount: 1
    Enabled: true
    Emitter:
      Type: Point
      LockToXY: false
      MeshPath: ""
    Material:
      TexturePath: textures/particles/smoke_puff.wtex
      MaterialPath: materials/particles/particle_alpha.wmat
      BlendMode: AlphaBlend
      FacingMode: Billboard
      EmissiveBoost: 1
      SoftParticle: false
      FadeDistance: 0.5
      SubUV:
        TilesX: 1
        TilesY: 1
        FPS: 0
        RandomStart: false
    Motion:
      Speed: 5
      SpeedVariance: 1
      Gravity: [0, -9.80000019, 0]
      LinearDrag: 0
      VortexStrength: 0
      VortexAxis: [0, 1, 0]
      TurbulenceStrength: 0
      TurbulenceFrequency: 1
    Evolution:
      SizeStart: 0.5
      SizeEnd: 0.100000001
      ColorStart: [1, 1, 1, 1]
      ColorEnd: [1, 1, 1, 0]
    Collision:
      Mode: None
      Restitution: 0.5
      Friction: 0.100000001
      KillOnHit: false
      EnableEvents: false
      PlaneOrigin: [0, 0, 0]
      PlaneNormal: [0, 1, 0]
    UseCustomShaderOverride: false
    Modules:
      - Id: mod.emitter.spawn_rate
        Name: 持续发射 (Spawn Rate)
        Description: 控制每秒持续发射的粒子数量与最大粒子容量 (火焰/浓烟/喷泉/火花流)
        Stage: Emitter
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: SpawnRate]\n    // 由系统发射调度器根据 SpawnRate 与 dt 累积并生成新图元\n"
        Parameters:
          - Name: SpawnRate
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 30
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 20000
            Step: 1
            Tooltip: 每秒持续发射粒子数 (/s)
            IsExposed: true
            ExposedName: EmissionRate
          - Name: MaxParticles
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 500
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 1
            Max: 100000
            Step: 10
            Tooltip: 最大粒子容量 (Max Particles)
            IsExposed: true
            ExposedName: MaxParticles
      - Id: mod.spawn.init_particle
        Name: 粒子初始化 (Initialize Particle)
        Description: 设定图元诞生时的基准生命周期、初始尺寸与渐变颜色
        Stage: Spawn
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: InitializeParticle]\n    p.MaxLife = u_Lifetime;\n    p.Life = u_Lifetime;\n    p.Size = float2(u_SizeStart);\n    p.Color = u_ColorStart;\n"
        Parameters:
          - Name: Lifetime
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 2.5
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.00999999978
            Max: 99999
            Step: 0.100000001
            Tooltip: 粒子存活基准寿命 (秒)
            IsExposed: true
            ExposedName: Lifetime
          - Name: SizeStart
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 0.600000024
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.00999999978
            Max: 20
            Step: 0.0500000007
            Tooltip: 诞生初始尺寸
            IsExposed: true
            ExposedName: SizeStart
          - Name: SizeEnd
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 2.4000001
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0.00999999978
            Max: 20
            Step: 0.0500000007
            Tooltip: 消亡终末尺寸
            IsExposed: true
            ExposedName: SizeEnd
          - Name: ColorStart
            Type: 3
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 0
            VecVal: [1, 0.800000012, 0.300000012, 1]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 0.0500000007
            Tooltip: 初始 RGBA 颜色
            IsExposed: false
            ExposedName: ""
          - Name: ColorEnd
            Type: 3
