          - Name: FacingMode
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 0
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 1
            Tooltip: 面片朝向 (0=Billboard相机对齐, 1=Horizontal地面水平)
            IsExposed: false
            ExposedName: ""
          - Name: EmissiveBoost
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            FloatVal: 3.5
            VecVal: [0, 0, 0, 0]
            IntVal: 0
