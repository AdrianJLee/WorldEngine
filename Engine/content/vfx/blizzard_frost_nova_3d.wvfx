            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 1
            Step: 1
            Tooltip: 混合模式 (0=半透 AlphaBlend, 1=加法 Additive)
            IsExposed: false
