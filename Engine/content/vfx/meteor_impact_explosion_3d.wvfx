# WorldEngine Particle Asset
FormatVersion: 2
Name: "MeteorImpactExplosion3D"
WarmupTime: 0
Looping: true
Emitters:
  - Name: "BlastShockwave"
    Enabled: true
    MaxParticles: 60
    Lifetime: 1.2
    EmissionRate: 20
