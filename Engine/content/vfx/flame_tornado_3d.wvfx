            Tooltip: 诞生初始尺寸
            IsExposed: true
            ExposedName: SizeStart
          - Name: SizeEnd
            Type: 0
            FloatVal: 2.20000005
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
