            AxisRandomMax: [10, 10, 10]
            AxisCurveExpanded: [false, false, false]
            ColorMode: [0, 0, 0, 0]
            ColorRandomMin: [0, 0, 0, 0]
            ColorRandomMax: [1, 1, 1, 1]
            ColorCurveExpanded: [false, false, false, false]
            FloatVal: 11
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: -50
            Max: 50
            Step: 0.5
            Tooltip: 切向旋转角速度强度
            IsExposed: false
            ExposedName: ""
          - Name: UpwardBuoyancy
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
