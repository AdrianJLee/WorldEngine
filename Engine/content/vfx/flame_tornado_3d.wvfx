            Step: 0.0500000007
            Tooltip: 底部圆盘半径 (米)
            IsExposed: false
            ExposedName: ""
          - Name: InitialSpeed
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            RandomMinVec: [0, 0, 0, 0]
