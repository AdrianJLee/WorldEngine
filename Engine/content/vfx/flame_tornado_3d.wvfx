      - Id: mod.update.vortex
        Name: 轴向旋转涡流 (Vortex Field)
        Description: 围绕指定三维轴线驱动粒子做切向飞旋龙卷运动
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: VortexField] 轴向切向旋转\n    float3 normAxis = normalize(u_VortexAxis.xyz);\n    float3 tangential = cross(normAxis, p.Position);\n    p.Velocity += tangential * (u_VortexStrength * dt);\n"
        Parameters:
          - Name: VortexAxis
            Type: 2
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            RandomMinVec: [0, 0, 0, 0]
            RandomMaxVec: [1, 1, 1, 1]
            SplitAxes: false
