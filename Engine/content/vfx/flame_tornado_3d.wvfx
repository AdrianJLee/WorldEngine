      - Id: mod.update.vortex_tornado
        Name: 龙卷风涡流与热浮力 (Vortex Tornado)
        Description: 模拟真实龙卷风动力学：切向旋转、高度锥形扩张与向上强热升浮力
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: Vortex Tornado]\n    float r = length(p.Position.xz);\n    if (r > 0.01f)\n    {\n        float3 tangent = cross(float3(0.0f, 1.0f, 0.0f), normalize(float3(p.Position.x, 0.0f, p.Position.z)));\n        p.Velocity.xz += tangent.xz * (u_VortexStrength * dt);\n    }\n    p.Velocity.y += u_UpwardBuoyancy * dt;\n    p.Velocity.xz += normalize(p.Position.xz) * (u_ConeExpansion * max(0.0f, p.Velocity.y) * dt);\n"
        Parameters:
          - Name: VortexStrength
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            RandomMinVec: [0, 0, 0, 0]
            RandomMaxVec: [1, 1, 1, 1]
            SplitAxes: false
            SplitColor: false
            ActiveAxisCurveChannel: 0
            ActiveColorCurveChannel: 0
            CurveExpanded: true
            AlphaCurveExpanded: false
            AxisMode: [0, 0, 0]
