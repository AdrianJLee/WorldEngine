            ColorMode: [0, 0, 0, 0]
            ColorRandomMin: [0, 0, 0, 0]
            ColorRandomMax: [1, 1, 1, 1]
            ColorCurveExpanded: [false, false, false, false]
            FloatVal: 0.200000003
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 10
            Step: 0.0500000007
            Tooltip: 底部圆盘半径 (米)
            IsExposed: false
            ExposedName: ""
          - Name: InitialSpeed
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            RandomMinVec: [0, 0, 0, 0]
            RandomMaxVec: [1, 1, 1, 1]
            SplitAxes: false
            SplitColor: false
            ActiveAxisCurveChannel: 0
            ActiveColorCurveChannel: 0
            CurveExpanded: true
            AlphaCurveExpanded: false
            AxisMode: [0, 0, 0]
            AxisRandomMin: [-10, -10, -10]
            AxisRandomMax: [10, 10, 10]
            AxisCurveExpanded: [false, false, false]
            ColorMode: [0, 0, 0, 0]
            ColorRandomMin: [0, 0, 0, 0]
            ColorRandomMax: [1, 1, 1, 1]
            ColorCurveExpanded: [false, false, false, false]
            FloatVal: 3
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 50
            Step: 0.200000003
            Tooltip: 发射初始基准速率 (m/s)
            IsExposed: false
            ExposedName: ""
          - Name: SpeedVariance
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            RandomMinVec: [0, 0, 0, 0]
            RandomMaxVec: [1, 1, 1, 1]
            SplitAxes: false
            SplitColor: false
            ActiveAxisCurveChannel: 0
            ActiveColorCurveChannel: 0
            CurveExpanded: true
            AlphaCurveExpanded: false
            AxisMode: [0, 0, 0]
            AxisRandomMin: [-10, -10, -10]
            AxisRandomMax: [10, 10, 10]
            AxisCurveExpanded: [false, false, false]
            ColorMode: [0, 0, 0, 0]
            ColorRandomMin: [0, 0, 0, 0]
