            Step: 0.100000001
            Tooltip: 发射速度随机扰动范围
            IsExposed: false
            ExposedName: ""
      - Id: mod.update.vortex_tornado
        Name: 龙卷风涡流与热浮力 (Vortex Tornado)
        Description: 模拟真实龙卷风动力学：切向旋转、高度锥形扩张与向上强热升浮力
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: Vortex Tornado]\n    float r = length(p.Position.xz);\n    if (r > 0.01f)\n    {\n        float3 tangent = cross(float3(0.0f, 1.0f, 0.0f), normalize(float3(p.Position.x, 0.0f, p.Position.z)));\n        p.Velocity.xz += tangent.xz * (u_VortexStrength * dt);\n    }\n    p.Velocity.y += u_UpwardBuoyancy * dt;\n    p.Velocity.xz += normalize(p.Position.xz) * (u_ConeExpansion * max(0.0f, p.Velocity.y) * dt);\n"
        Parameters:
          - Name: VortexStrength
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            RandomMinVec: [0, 0, 0, 0]
            RandomMaxVec: [1, 1, 1, 1]
            SplitAxes: false
            SplitColor: false
            ActiveAxisCurveChannel: 0
            ActiveColorCurveChannel: 0
            CurveExpanded: true
            AlphaCurveExpanded: false
            AxisMode: [0, 0, 0]
            AxisRandomMin: [-10, -10, -10]
            AxisRandomMax: [10, 10, 10]
            AxisCurveExpanded: [false, false, false]
            ColorMode: [0, 0, 0, 0]
            ColorRandomMin: [0, 0, 0, 0]
            ColorRandomMax: [1, 1, 1, 1]
            ColorCurveExpanded: [false, false, false, false]
            FloatVal: 15
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: -50
            Max: 50
            Step: 0.5
            Tooltip: 切向旋转角速度强度
            IsExposed: false
            ExposedName: ""
          - Name: UpwardBuoyancy
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            RandomMinVec: [0, 0, 0, 0]
            RandomMaxVec: [1, 1, 1, 1]
            SplitAxes: false
            SplitColor: false
            ActiveAxisCurveChannel: 0
            ActiveColorCurveChannel: 0
            CurveExpanded: true
            AlphaCurveExpanded: false
            AxisMode: [0, 0, 0]
            AxisRandomMin: [-10, -10, -10]
            AxisRandomMax: [10, 10, 10]
            AxisCurveExpanded: [false, false, false]
            ColorMode: [0, 0, 0, 0]
            ColorRandomMin: [0, 0, 0, 0]
            ColorRandomMax: [1, 1, 1, 1]
            ColorCurveExpanded: [false, false, false, false]
            FloatVal: 6.5
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 30
            Step: 0.200000003
            Tooltip: 向上垂直热升浮力加速度
            IsExposed: false
            ExposedName: ""
          - Name: ConeExpansion
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            RandomMinVec: [0, 0, 0, 0]
            RandomMaxVec: [1, 1, 1, 1]
            SplitAxes: false
            SplitColor: false
            ActiveAxisCurveChannel: 0
            ActiveColorCurveChannel: 0
            CurveExpanded: true
            AlphaCurveExpanded: false
            AxisMode: [0, 0, 0]
            AxisRandomMin: [-10, -10, -10]
            AxisRandomMax: [10, 10, 10]
            AxisCurveExpanded: [false, false, false]
            ColorMode: [0, 0, 0, 0]
            ColorRandomMin: [0, 0, 0, 0]
            ColorRandomMax: [1, 1, 1, 1]
            ColorCurveExpanded: [false, false, false, false]
            FloatVal: 0.449999988
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
