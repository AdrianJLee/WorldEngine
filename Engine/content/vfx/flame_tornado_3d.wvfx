      - Id: mod.update.scale_over_life
        Name: 尺寸随寿命缩放 (Scale Over Life)
        Description: 基于归一化存活进度 (0~1) 控制粒子尺寸膨胀扩散或缩小消亡
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: Scale Over Life]\n    float normLife = clamp(1.0f - (p.Life / max(0.001f, p.MaxLife)), 0.0f, 1.0f);\n    p.Size = lerp(u_StartScale, u_EndScale, normLife);\n"
        Parameters:
          - Name: StartScale
            Type: 0
            Mode: 0
            RandomMin: 0
            RandomMax: 1
            RandomMinVec: [0, 0, 0, 0]
