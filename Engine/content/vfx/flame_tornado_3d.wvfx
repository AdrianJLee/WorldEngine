      - Id: mod.spawn.cone
        Name: 圆锥发射 (Cone Spawn)
        Description: 按圆锥顶角与底面半径空间分布发射粒子并赋予初始初速度
        Stage: Spawn
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: ConeSpawn] 圆锥发射空间分布算法\n    float angleRad = radians(u_ConeAngle);\n    float u = Hash1D(particleId * 3 + 1);\n    float v = Hash1D(particleId * 3 + 2);\n    float phi = 6.2831853f * u;\n    float sinTheta = sin(angleRad) * sqrt(v);\n    float cosTheta = sqrt(max(0.0f, 1.0f - sinTheta * sinTheta));\n    float3 localDir = float3(sinTheta * cos(phi), cosTheta, sinTheta * sin(phi));\n    \n    float diskR = u_ConeRadius * sqrt(Hash1D(particleId * 3 + 0));\n    float diskPhi = 6.2831853f * Hash1D(particleId * 3 + 7);\n    p.Position = float3(diskR * cos(diskPhi), 0.0f, diskR * sin(diskPhi));\n    \n    float speed = u_InitialSpeed + (Hash1D(particleId * 7 + 3) * 2.0f - 1.0f) * u_SpeedVariance;\n    p.Velocity = localDir * speed;\n"
        Parameters:
          - Name: ConeAngle
            Type: 0
            FloatVal: 30
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 90
            Step: 1
            Tooltip: 圆锥半角 (度)
            IsExposed: false
            ExposedName: ""
          - Name: ConeRadius
            Type: 0
            FloatVal: 0.5
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 10
            Step: 0.0500000007
            Tooltip: 底部圆盘半径 (米)
            IsExposed: false
            ExposedName: ""
          - Name: InitialSpeed
            Type: 0
            FloatVal: 5
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 50
            Step: 0.200000003
            Tooltip: 发射初始基准速率 (m/s)
            IsExposed: false
            ExposedName: ""
          - Name: SpeedVariance
            Type: 0
            FloatVal: 1
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: 0
            Max: 20
            Step: 0.100000001
            Tooltip: 发射速度随机扰动范围
            IsExposed: false
            ExposedName: ""
      - Id: mod.update.gravity
        Name: 重力场 (Gravity Force)
        Description: 对粒子施加恒定三维重力加速度向量
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: GravityForce]\n    p.Velocity += u_Gravity.xyz * dt;\n"
        Parameters:
          - Name: Gravity
            Type: 2
            FloatVal: 0
            VecVal: [0, 2.5, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: -50
            Max: 50
            Step: 0.200000003
            Tooltip: 三维重力向量 [Gx, Gy, Gz]
            IsExposed: false
            ExposedName: ""
      - Id: mod.update.vortex
        Name: 轴向旋转涡流 (Vortex Field)
        Description: 围绕指定三维轴线驱动粒子做切向飞旋龙卷运动
        Stage: Update
        Enabled: true
        IsCustom: false
        SlangSource: "\n    // [Module: VortexField] 轴向切向旋转\n    float3 normAxis = normalize(u_VortexAxis.xyz);\n    float3 tangential = cross(normAxis, p.Position);\n    p.Velocity += tangential * (u_VortexStrength * dt);\n"
        Parameters:
          - Name: VortexAxis
            Type: 2
            FloatVal: 0
            VecVal: [0, 1, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: -1
            Max: 1
            Step: 0.0500000007
            Tooltip: 涡流旋转轴向量
            IsExposed: false
            ExposedName: ""
          - Name: VortexStrength
            Type: 0
            FloatVal: 4
            VecVal: [0, 0, 0, 0]
            IntVal: 0
            BoolVal: false
            Min: -30
            Max: 30
            Step: 0.200000003
            Tooltip: 旋转切向角速度强度
            IsExposed: false
            ExposedName: ""
