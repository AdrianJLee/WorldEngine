{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.4",
  "workspace.library": ["projects/default/assets/scripts/intermediate"],
  "workspace.ignoreDir": [".git", ".codex", ".vscode", "build", "vendor", "Engine/vendor", "tools", "tests/lua", "projects/default/assets/scripts/tests"],
  "workspace.checkThirdParty": false,
  "diagnostics.libraryFiles": "Disable",
  "hint.enable": true,
  "hint.paramType": true,
  "hint.setType": true
}
